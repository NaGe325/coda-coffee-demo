<script>
  // ── navigation ──────────────────────────────────────────
  const SCREENS = ['home','scan','reveal','journey','impact','story'];

  function goTo(id) {
    SCREENS.forEach(s => {
      const el = document.getElementById('screen-' + s);
      if (el) el.classList.toggle('active', s === id);
    });
    // scroll to top
    const active = document.getElementById('screen-' + id);
    if (active) {
      const body = active.querySelector('.scroll-body');
      if (body) body.scrollTop = 0;
    }
  }

  function switchTab(id) {
    // home → home screen, scan → scan screen, impact → impact screen
    if (id === 'home') goTo('home');
    else if (id === 'scan') goTo('scan');
    else if (id === 'impact') goTo('impact');
  }

  // ── toast ────────────────────────────────────────────────
  function showToast(msg) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 2800);
  }

  // ── keyboard shortcut for demo (1-6 keys) ───────────────
  document.addEventListener('keydown', e => {
    const map = {'1':'home','2':'scan','3':'reveal','4':'journey','5':'impact','6':'story'};
    if (map[e.key]) goTo(map[e.key]);
  });
</script>
