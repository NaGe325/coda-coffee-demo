<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>Coda Coffee — Bean Journey</title>
<style>
  /* ── reset & base ── */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  :root {
    --espresso:  #2D1A0E;
    --latte:     #8D6543;
    --latte-lt:  #D7A97A;
    --cream:     #F5EFE6;
    --sand:      #E8D9C4;
    --tan:       #C4B89A;
    --sage:      #3B6D11;
    --sage-lt:   #EAF3DE;
    --amber:     #BA7517;
    --amber-lt:  #FAEEDA;
    --slate:     #4A5568;
    --white:     #FFFFFF;
    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-lg: 20px;
    --radius-xl: 32px;
  }
  html, body {
    height: 100%;
    background: #1a1a1a;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* ── phone shell ── */
  .device {
    width: 375px;
    min-height: 812px;
    background: var(--cream);
    border-radius: 48px;
    overflow: hidden;
    position: relative;
    box-shadow: 0 40px 80px rgba(0,0,0,0.5), 0 0 0 2px #333;
  }
  .status-bar {
    background: var(--espresso);
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 24px;
  }
  .status-bar span { color: #fff; font-size: 12px; font-weight: 600; }
  .status-time { font-size: 15px !important; }

  /* ── screen system ── */
  .screen { display: none; flex-direction: column; height: calc(812px - 44px); }
  .screen.active { display: flex; }
  .scroll-body { flex: 1; overflow-y: auto; overflow-x: hidden; }
  .scroll-body::-webkit-scrollbar { display: none; }

  /* ── bottom nav ── */
  .bottom-nav {
    display: flex;
    background: var(--white);
    border-top: 1px solid var(--sand);
    padding: 8px 0 20px;
  }
  .nav-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    cursor: pointer;
    padding: 4px 0;
  }
  .nav-icon {
    width: 24px; height: 24px;
    display: flex; align-items: center; justify-content: center;
  }
  .nav-icon svg { width: 22px; height: 22px; stroke: var(--tan); fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .nav-item.active .nav-icon svg { stroke: var(--latte); }
  .nav-label { font-size: 10px; color: var(--tan); font-weight: 500; }
  .nav-item.active .nav-label { color: var(--latte); }

  /* ── shared components ── */
  .hero-bar {
    background: var(--espresso);
    padding: 16px 20px 14px;
  }
  .hero-eyebrow { font-size: 10px; color: var(--latte-lt); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 4px; }
  .hero-title { font-size: 20px; font-weight: 700; color: #fff; line-height: 1.2; }
  .hero-sub { font-size: 12px; color: var(--latte-lt); margin-top: 4px; }
  .back-row {
    display: flex; align-items: center; gap: 8px;
    cursor: pointer;
  }
  .back-btn { font-size: 22px; color: var(--latte-lt); line-height: 1; }
  .back-title { font-size: 15px; font-weight: 600; color: #fff; }
  .back-tag { margin-left: auto; font-size: 10px; color: var(--latte-lt); }

  .section-label {
    font-size: 10px; font-weight: 700; color: var(--tan);
    text-transform: uppercase; letter-spacing: 0.08em;
    padding: 14px 20px 8px;
  }

  /* pill badge */
  .badge {
    display: inline-block; font-size: 10px; font-weight: 700;
    padding: 2px 8px; border-radius: 20px;
  }
  .badge-green { background: var(--sage-lt); color: var(--sage); }
  .badge-amber { background: var(--amber-lt); color: var(--amber); }

  /* card */
  .card {
    background: var(--white);
    border-radius: var(--radius-md);
    border: 1px solid var(--sand);
    margin: 0 16px 12px;
    overflow: hidden;
  }
  .card-pad { padding: 14px 16px; }

  /* ── SCREEN: HOME ── */
  .qr-cta {
    margin: 14px 16px 0;
    background: rgba(255,255,255,0.10);
    border: 1px solid rgba(215,169,122,0.35);
    border-radius: var(--radius-md);
    padding: 12px 14px;
    display: flex; align-items: center; gap: 12px;
    cursor: pointer;
  }
  .qr-cta:active { opacity: 0.8; }
  .qr-box {
    width: 40px; height: 40px;
    background: var(--latte-lt);
    border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .qr-box svg { width: 22px; height: 22px; stroke: var(--espresso); fill: none; stroke-width: 2; }
  .qr-text { flex: 1; }
  .qr-title { font-size: 14px; font-weight: 600; color: #fff; }
  .qr-sub { font-size: 11px; color: var(--latte-lt); margin-top: 2px; }
  .qr-arrow { font-size: 20px; color: var(--latte-lt); }

  /* bean card */
  .bean-card {
    background: var(--white);
    border-radius: var(--radius-md);
    border: 1px solid var(--sand);
    margin: 0 16px 10px;
    padding: 14px 14px 12px;
    cursor: pointer;
  }
  .bean-card:active { background: #faf6f0; }
  .bean-top { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
  .bean-flag {
    width: 34px; height: 34px; border-radius: 50%;
    background: var(--sand);
    display: flex; align-items: center; justify-content: center;
    font-size: 18px; flex-shrink: 0;
  }
  .bean-info { flex: 1; }
  .bean-name { font-size: 14px; font-weight: 600; color: var(--espresso); }
  .bean-origin { font-size: 11px; color: var(--slate); margin-top: 1px; }
  .score-pill {
    background: var(--sage-lt); color: var(--sage);
    font-size: 11px; font-weight: 700;
    padding: 3px 9px; border-radius: 20px;
  }
  .flavor-bars { display: flex; flex-direction: column; gap: 5px; }
  .flavor-row { display: flex; align-items: center; gap: 8px; }
  .flavor-label { font-size: 10px; color: var(--tan); width: 56px; flex-shrink: 0; }
  .flavor-track { flex: 1; height: 4px; background: var(--sand); border-radius: 4px; }
  .flavor-fill { height: 4px; background: var(--latte); border-radius: 4px; }

  /* story card */
  .story-card {
    background: var(--white);
    border-radius: var(--radius-md);
    border: 1px solid var(--sand);
    margin: 0 16px 10px;
    overflow: hidden;
    cursor: pointer;
  }
  .story-card:active { opacity: 0.88; }
  .story-img {
    height: 88px;
    background: linear-gradient(135deg, var(--latte) 0%, var(--espresso) 100%);
    display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 4px;
  }
  .story-img-icon { font-size: 28px; }
  .story-img-caption { font-size: 10px; color: rgba(255,255,255,0.65); }
  .story-body { padding: 10px 14px 12px; }
  .story-title { font-size: 13px; font-weight: 600; color: var(--espresso); line-height: 1.4; }
  .story-desc { font-size: 11px; color: var(--slate); margin-top: 4px; line-height: 1.5; }

  /* ── SCREEN: SCAN ── */
  .scan-area {
    margin: 24px 20px 0;
    border: 2px dashed var(--latte);
    border-radius: var(--radius-md);
    height: 160px;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 10px;
  }
  .scan-icon-box {
    width: 52px; height: 52px;
    background: var(--amber-lt);
    border-radius: var(--radius-sm);
    display: flex; align-items: center; justify-content: center;
  }
  .scan-icon-box svg { width: 28px; height: 28px; stroke: var(--amber); fill: none; stroke-width: 2; }
  .scan-hint { font-size: 14px; font-weight: 600; color: var(--espresso); }
  .scan-sub { font-size: 11px; color: var(--slate); }

  .or-row { display: flex; align-items: center; gap: 10px; margin: 16px 20px; }
  .or-line { flex: 1; height: 1px; background: var(--sand); }
  .or-text { font-size: 11px; color: var(--tan); }

  .batch-input {
    margin: 0 20px;
    background: var(--sand);
    border-radius: var(--radius-sm);
    padding: 10px 14px;
    font-size: 14px; font-weight: 600;
    color: var(--slate);
    letter-spacing: 0.05em;
    border: none; width: calc(100% - 40px);
    font-family: 'SF Mono', 'Fira Code', monospace;
    outline: none;
  }
  .batch-input:focus { box-shadow: 0 0 0 2px var(--latte); }

  .primary-btn {
    display: block; width: calc(100% - 40px);
    margin: 14px 20px 0;
    background: var(--espresso);
    color: #fff;
    border: none; border-radius: var(--radius-md);
    padding: 14px;
    font-size: 14px; font-weight: 600;
    cursor: pointer;
    text-align: center;
  }
  .primary-btn:active { opacity: 0.85; }

  .recent-row {
    display: flex; align-items: center; gap: 10px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--sand);
    cursor: pointer;
  }
  .recent-row:last-child { border-bottom: none; }
  .recent-row:active { background: #f9f5f0; }
  .recent-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--latte); flex-shrink: 0; }
  .recent-name { flex: 1; font-size: 13px; font-weight: 500; color: var(--espresso); }
  .recent-date { font-size: 11px; color: var(--tan); }

  /* ── SCREEN: FARMER REVEAL ── */
  .reveal-wrap {
    display: flex; flex-direction: column; align-items: center;
    padding: 28px 20px 20px;
  }
  .farmer-avatar {
    width: 88px; height: 88px; border-radius: 50%;
    background: var(--latte-lt);
    display: flex; align-items: center; justify-content: center;
    font-size: 44px; margin-bottom: 14px;
    border: 3px solid var(--latte);
  }
  .farmer-name { font-size: 22px; font-weight: 700; color: var(--espresso); text-align: center; }
  .farmer-loc { font-size: 13px; color: var(--slate); text-align: center; margin-top: 3px; }

  .payment-box {
    width: 100%;
    background: var(--sage-lt);
    border: 1px solid var(--sage);
    border-radius: var(--radius-md);
    padding: 12px 16px; margin-top: 16px;
  }
  .payment-title { font-size: 12px; font-weight: 700; color: var(--sage); margin-bottom: 4px; }
  .payment-val { font-size: 14px; font-weight: 600; color: #27500A; }

  .score-row {
    display: flex; align-items: center; gap: 10px;
    width: 100%; margin-top: 12px;
    background: var(--white);
    border: 1px solid var(--sand);
    border-radius: var(--radius-md);
    padding: 12px 16px;
  }
  .score-num { font-size: 32px; font-weight: 700; color: var(--latte); }
  .score-info { flex: 1; }
  .score-label { font-size: 12px; font-weight: 600; color: var(--espresso); }
  .score-sub { font-size: 11px; color: var(--slate); margin-top: 2px; }

  .farmer-story {
    width: 100%; margin-top: 12px;
    font-size: 13px; color: var(--slate);
    line-height: 1.65;
  }
  .moat-badge {
    width: 100%; margin-top: 14px;
    background: var(--espresso);
    border-radius: var(--radius-md);
    padding: 11px 16px;
    font-size: 11px; color: var(--latte-lt);
    line-height: 1.5;
    text-align: center;
  }
  .moat-strong { color: #fff; font-weight: 600; }

  .outline-btn {
    display: block; width: 100%;
    margin-top: 14px;
    background: transparent;
    color: var(--espresso);
    border: 1.5px solid var(--latte);
    border-radius: var(--radius-md);
    padding: 13px;
    font-size: 14px; font-weight: 600;
    cursor: pointer; text-align: center;
  }
  .outline-btn:active { background: var(--sand); }

  /* ── SCREEN: JOURNEY ── */
  .chain-step {
    display: flex; align-items: flex-start; gap: 12px;
    padding: 12px 20px;
    border-bottom: 1px solid var(--sand);
    position: relative;
  }
  .chain-step:last-child { border-bottom: none; }
  .step-icon-wrap { display: flex; flex-direction: column; align-items: center; gap: 0; flex-shrink: 0; }
  .step-icon {
    width: 34px; height: 34px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 16px; flex-shrink: 0;
  }
  .step-icon.done { background: var(--sage-lt); }
  .step-icon.active { background: var(--amber-lt); }
  .step-icon.pending { background: var(--sand); opacity: 0.5; }
  .step-vline { width: 1.5px; flex: 1; min-height: 20px; background: var(--sand); margin-top: 4px; }
  .step-body { flex: 1; padding-bottom: 4px; }
  .step-title { font-size: 14px; font-weight: 600; color: var(--espresso); }
  .step-detail { font-size: 11px; color: var(--slate); margin-top: 2px; line-height: 1.5; }
  .step-time { font-size: 10px; color: var(--tan); margin-top: 3px; }
  .step-verified {
    display: inline-flex; align-items: center; gap: 3px;
    background: var(--sage-lt); color: var(--sage);
    font-size: 9px; font-weight: 700;
    padding: 2px 7px; border-radius: 20px; margin-top: 4px;
  }
  .step-progress {
    display: inline-block;
    background: var(--amber-lt); color: var(--amber);
    font-size: 9px; font-weight: 700;
    padding: 2px 7px; border-radius: 20px; margin-top: 4px;
  }

  .batch-meta {
    padding: 10px 20px;
    font-size: 11px; color: var(--tan);
    border-bottom: 1px solid var(--sand);
  }
  .batch-meta span { font-weight: 600; color: var(--slate); }

  .payment-summary {
    margin: 12px 16px;
    background: var(--white);
    border: 1px solid var(--sand);
    border-radius: var(--radius-md);
    padding: 12px 16px;
  }
  .ps-label { font-size: 11px; color: var(--tan); margin-bottom: 3px; }
  .ps-val { font-size: 15px; font-weight: 700; color: var(--espresso); }
  .ps-sub { font-size: 10px; color: var(--sage); margin-top: 2px; }

  /* ── SCREEN: IMPACT ── */
  .impact-hero { background: var(--espresso); padding: 16px 20px; }
  .impact-hero-title { font-size: 18px; font-weight: 700; color: #fff; }
  .impact-hero-sub { font-size: 12px; color: var(--latte-lt); margin-top: 3px; }

  .stat-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; padding: 14px 16px 0; }
  .stat-tile {
    background: var(--white);
    border: 1px solid var(--sand);
    border-radius: var(--radius-md);
    padding: 12px 12px 10px;
  }
  .stat-num { font-size: 24px; font-weight: 700; color: var(--latte); }
  .stat-label { font-size: 10px; color: var(--slate); margin-top: 2px; line-height: 1.4; }

  .farmer-chip {
    display: flex; align-items: center; gap: 10px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--sand);
    cursor: pointer;
  }
  .farmer-chip:active { background: #f9f5f0; }
  .farmer-chip:last-child { border-bottom: none; }
  .chip-avatar {
    width: 36px; height: 36px; border-radius: 50%;
    background: var(--latte-lt);
    display: flex; align-items: center; justify-content: center;
    font-size: 18px; flex-shrink: 0;
  }
  .chip-info { flex: 1; }
  .chip-name { font-size: 13px; font-weight: 600; color: var(--espresso); }
  .chip-detail { font-size: 11px; color: var(--slate); margin-top: 1px; }
  .chip-arrow { font-size: 18px; color: var(--tan); }

  .share-cta {
    margin: 14px 16px;
    background: var(--sage-lt);
    border: 1px solid var(--sage);
    border-radius: var(--radius-md);
    padding: 12px 16px;
    display: flex; align-items: center; gap: 12px;
    cursor: pointer;
  }
  .share-icon { font-size: 24px; }
  .share-text .share-title { font-size: 13px; font-weight: 600; color: var(--sage); }
  .share-text .share-sub { font-size: 11px; color: #3B6D11; margin-top: 1px; }

  /* ── toast ── */
  .toast {
    position: absolute; bottom: 100px; left: 20px; right: 20px;
    background: var(--espresso); color: #fff;
    border-radius: var(--radius-md); padding: 12px 16px;
    font-size: 13px; font-weight: 500;
    text-align: center; opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none; z-index: 99;
  }
  .toast.show { opacity: 1; }

  /* scrollbar hidden globally */
  * { scrollbar-width: none; -ms-overflow-style: none; }
</style>
</head>
<body>

<div class="device">
  <div class="status-bar">
    <span class="status-time">9:41</span>
    <span>Coda Coffee</span>
    <span>●●●</span>
  </div>

  <!-- ══════════════════════════════════
       SCREEN 1: HOME / DISCOVER
  ══════════════════════════════════ -->
  <div id="screen-home" class="screen active">
    <div class="scroll-body">
      <div class="hero-bar">
        <div class="hero-eyebrow">Good morning</div>
        <div class="hero-title">Know your coffee,<br>know your farmer.</div>
        <div class="hero-sub">Every cup has a story. Start yours.</div>
        <div class="qr-cta" onclick="goTo('scan')">
          <div class="qr-box">
            <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M14 14h2v2h-2zM18 14h3M14 18v3M18 18h3v3"/></svg>
          </div>
          <div class="qr-text">
            <div class="qr-title">Scan your bag</div>
            <div class="qr-sub">Trace beans from farm to cup</div>
          </div>
          <div class="qr-arrow">›</div>
        </div>
      </div>

      <div class="section-label">Current offerings</div>

      <div class="bean-card" onclick="goTo('reveal')">
        <div class="bean-top">
          <div class="bean-flag">🇺🇬</div>
          <div class="bean-info">
            <div class="bean-name">Great Lakes Washed</div>
            <div class="bean-origin">Kampala region, Uganda</div>
          </div>
          <div class="score-pill">86.2</div>
        </div>
        <div class="flavor-bars">
          <div class="flavor-row">
            <div class="flavor-label">Brightness</div>
            <div class="flavor-track"><div class="flavor-fill" style="width:78%"></div></div>
          </div>
          <div class="flavor-row">
            <div class="flavor-label">Body</div>
            <div class="flavor-track"><div class="flavor-fill" style="width:62%"></div></div>
          </div>
          <div class="flavor-row">
            <div class="flavor-label">Sweetness</div>
            <div class="flavor-track"><div class="flavor-fill" style="width:85%"></div></div>
          </div>
        </div>
      </div>

      <div class="bean-card">
        <div class="bean-top">
          <div class="bean-flag">🇧🇷</div>
          <div class="bean-info">
            <div class="bean-name">AFASA Natural</div>
            <div class="bean-origin">Minas Gerais, Brazil</div>
          </div>
          <div class="score-pill">85.5</div>
        </div>
        <div class="flavor-bars">
          <div class="flavor-row">
            <div class="flavor-label">Brightness</div>
            <div class="flavor-track"><div class="flavor-fill" style="width:52%"></div></div>
          </div>
          <div class="flavor-row">
            <div class="flavor-label">Body</div>
            <div class="flavor-track"><div class="flavor-fill" style="width:88%"></div></div>
          </div>
          <div class="flavor-row">
            <div class="flavor-label">Sweetness</div>
            <div class="flavor-track"><div class="flavor-fill" style="width:91%"></div></div>
          </div>
        </div>
      </div>

      <div class="section-label">Stories from the farm</div>

      <div class="story-card" onclick="goTo('story')">
        <div class="story-img">
          <div class="story-img-icon">☕</div>
          <div class="story-img-caption">Kampala, Uganda · Feb 2025</div>
        </div>
        <div class="story-body">
          <div class="story-title">How Amara tripled her yield in two seasons</div>
          <div class="story-desc">After joining Farm2Cup, she switched bean varieties and adjusted her drying schedule — with measurable results.</div>
        </div>
      </div>

      <div style="height:16px"></div>
    </div>

    <nav class="bottom-nav">
      <div class="nav-item active" onclick="switchTab('home')">
        <div class="nav-icon">
          <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        </div>
        <div class="nav-label">Discover</div>
      </div>
      <div class="nav-item" onclick="switchTab('scan')">
        <div class="nav-icon">
          <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M14 14h2v2h-2zM18 14h3M14 18v3M18 18h3v3"/></svg>
        </div>
        <div class="nav-label">Trace</div>
      </div>
      <div class="nav-item" onclick="switchTab('impact')">
        <div class="nav-icon">
          <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <div class="nav-label">Impact</div>
      </div>
    </nav>
  </div>

  <!-- ══════════════════════════════════
       SCREEN 2: SCAN
  ══════════════════════════════════ -->
